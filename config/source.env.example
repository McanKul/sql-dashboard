# Bu dosyayi Git disinda kopyalayin. KEY=value bicimi kullanin; shell kodu
# calistirilmaz. Parolayi dogrudan buraya yazmak yerine 0600 secret dosyasi verin.
SOURCE_ALIAS=production-main
SOURCE_HOST=db.example.internal
SOURCE_PORT=5432
SOURCE_MONITORING_DB=powa
SOURCE_COLLECTOR_USER=powa_collector
SOURCE_PASSWORD_FILE=/secure/path/powa-collector.password
SOURCE_FREQUENCY=60
SOURCE_COALESCE=100
SOURCE_RETENTION=90 days

# Kaynak cluster DBA tarafindan hazirlanmadiysa PREPARE_SOURCE=true yapin.
# Bu yol PoWA/pg_qualstats binary'lerini kurmaz, postgresql.conf'u degistirmez
# ve cluster'i restart etmez. DBA once pg_stat_statements + pg_qualstats preload
# kosulunu saglar; script kurulu extension'lari etkinlestirip DB/rol/grant olusturur.
PREPARE_SOURCE=false
SOURCE_ADMIN_USER=postgres
SOURCE_ADMIN_DB=postgres
SOURCE_ADMIN_PASSWORD_FILE=/secure/path/postgres-admin.password
