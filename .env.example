# Yalnizca yerel gelistirme icindir. Canli ortamda secret manager kullanin.
POSTGRES_ADMIN_PASSWORD=change-me-admin
POWA_COLLECTOR_PASSWORD=change-me-collector
ADVISOR_API_PASSWORD=change-me-api
ADVISOR_EVALUATOR_PASSWORD=change-me-evaluator
EVALUATOR_TOKEN=change-me-internal-evaluator-token
ADVISOR_JOIN_SOURCE_PASSWORD=change-me-join-source
ADVISOR_JOIN_REPOSITORY_PASSWORD=change-me-join-repository
CLONE_ADMIN_PASSWORD=change-me-clone-admin
CLONE_RUNNER_PASSWORD=change-me-clone-runner
CLONE_EVALUATOR_TOKEN=change-me-internal-clone-token
# Yalniz guvenilir yerel/operator istemcisine verilir; browser bundle'ina koymayin.
# Bos birakilirsa admin endpoint'leri fail-closed kapali kalir (minimum 16 karakter).
RUNTIME_ADMIN_TOKEN=change-me-runtime-admin-token

# Host portlari
SOURCE_DB_BIND=127.0.0.1
SOURCE_DB_PORT=15432
REPOSITORY_DB_BIND=127.0.0.1
REPOSITORY_DB_PORT=15433
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=5173

# Uygulama ayarlari
DEFAULT_WINDOW=24h
RETENTION_DAYS=90
LOG_LEVEL=INFO

# Iterasyon 2.1-B pg_qualstats kaynak ayarlari. Kabul workload'u yalniz kendi
# oturumunda sample_rate=1 kullanir; global varsayilan kontrollu olarak 0.1'dir.
PG_QUALSTATS_SAMPLE_RATE=0.1
PG_QUALSTATS_MAX=10000
SOURCE_DB_SHM_SIZE=256mb

# Iterasyon 2.4 wait sampling. Deger milisaniyedir; canlida benchmark olmadan
# daha sik orneklemeyin. sample_cpu kapali tutulur, CPU kcache'den gelir.
PG_WAIT_SAMPLING_PROFILE_PERIOD_MS=10

# Iterasyon 2.5 outbox aktarimi ve 2.7 istege bagli tmpfs clone sinirlari.
JOIN_SOURCE_ALIAS=test-source
JOIN_POLL_INTERVAL_SECONDS=2
JOIN_RETENTION_DAYS=30
JOIN_HEALTH_MAX_AGE_SECONDS=60
JOIN_HEALTH_START_PERIOD=30s
CLONE_DATA_TMPFS_SIZE=1g
CLONE_WARMUP_RUNS=1
CLONE_MEASURED_RUNS=5
CLONE_MIN_IMPROVEMENT_PERCENT=10

# Temiz gercek-DB kurulumunda false yapin. Yalniz bos repository volume'unun
# ilk bootstrap'inda okunur. Sentetik trafik ayrica --profile demo gerektirir.
REGISTER_DEMO_SOURCE=true

# Collector'daki tum dis kaynaklar icin ortak libpq TLS modu. verify-full icin
# kurum CA/certificate dosyalarini collector'a ayrica mount etmeniz gerekir.
POWA_SOURCE_SSLMODE=prefer
